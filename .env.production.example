# Server Configuration (Isolated port to avoid clashing with other services)
PORT=5005
NODE_ENV=production

# Local MongoDB (Isolated database name: labtest)
MONGO_URI=mongodb://<USER>:<PASSWORD>@127.0.0.1:27017/labtest?authSource=admin

# Security
JWT_SECRET=hdi_lab_portal_secret_key_2026_super_secure

# Microsoft Azure Email Configuration (Nodemailer / Graph API)
AZURE_TENANT_ID=halalcert.com.ng
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
EMAIL_USER=ict@halalcert.com.ng

COMPANY_NOTIFICATION_EMAIL=registry@hdilabportal.com
FATIMAH_EMAIL=fatimah@hdilabportal.com

# Frontend URL
FRONTEND_URL=https://labtest.hdiportal.com
